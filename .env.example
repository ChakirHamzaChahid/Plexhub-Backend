# ============================================================================
# PlexHub Backend — modèle de configuration
# ----------------------------------------------------------------------------
# Copier ce fichier en `.env` (gitignoré) puis renseigner les valeurs.
# NE JAMAIS commiter de secret réel ici : `.env.example` est suivi par git.
# Les valeurs ci-dessous sont les DÉFAUTS du code (app/config.py) ; ne décommenter
# que ce que tu veux surcharger. Les clés marquées « REQUIS » n'ont pas de défaut.
# ============================================================================

# --- TMDB (enrichissement métadonnées) -------------------------------------
# REQUIS pour l'enrichissement (sinon désactivé). Clé v3 TMDB.
TMDB_API_KEY=
# Locale des requêtes TMDB.
TMDB_LANGUAGE=fr-FR

# --- OMDb (validateur de cohérence tmdb_id/imdb_id, complément de TMDB) ----
# Optionnel. "" = tie-break enrichissement + repli du validateur désactivés
# (le script validate_id_consistency tourne quand même, avec plus d'UNCERTAIN).
OMDB_API_KEY=
# Budget d'appels OMDb/jour (plan payant 100k/j — défaut = marge de 5k pour absorber les retries).
OMDB_DAILY_LIMIT=95000

# --- Authentification API / IA ---------------------------------------------
# REQUIS pour /api/ai (header X-API-Key) et POST /api/tv-auth/approve.
# Sert aussi à dériver la clé Fernet TV si TV_AUTH_ENCRYPTION_KEY est vide.
AI_API_KEY=

# --- Interface admin (/admin, /docs, /openapi.json) — HTTP Basic Auth -------
# Distincte du X-API-Key ci-dessus (navigateur : impossible d'envoyer un
# header custom sur une simple navigation). ⚠️ DÉFAUT DANGEREUX : tant que
# ADMIN_PASSWORD est vide, /admin + /docs répondent 503 (fail-closed) — donc
# aucun accès n'est exposé par défaut, mais renseigner ADMIN_PASSWORD est
# REQUIS pour utiliser l'UI admin/Swagger.
ADMIN_USERNAME=admin
# REQUIS pour activer /admin + /docs (sinon 503 fail-closed).
ADMIN_PASSWORD=

# --- Métriques Prometheus (/metrics) — HTTP Basic Auth dédiée --------------
# AUDIT-P2-001/CR-S02 (ADR 0004 §Décision 3) : /metrics n'est PLUS public par
# défaut — un scraper Prometheus déjà en place TOMBE en 401 tant que ce
# couple n'est pas renseigné ET configuré côté prometheus.yml (`basic_auth:`).
# Secret DÉDIÉ, distinct d'ADMIN_*/AI_API_KEY (un scraper compromis ne doit
# ouvrir ni l'admin ni l'API). ⚠️ Tant que METRICS_PASSWORD est vide,
# /metrics répond 503 (fail-closed, même convention qu'ADMIN_PASSWORD).
METRICS_USERNAME=plexhub-metrics
# REQUIS pour activer /metrics (sinon 503 fail-closed).
METRICS_PASSWORD=
# Filet de transition UNIQUEMENT (défaut false = sûr) : rouvre /metrics SANS
# authentification le temps de reconfigurer le scraper. Un WARNING est
# loggé au boot tant que c'est actif. Ne jamais laisser à true en continu.
METRICS_PUBLIC=false

# --- Embeddings (recommandations vectorielles) -----------------------------
# Surcharge du modèle fastembed (défaut interne : paraphrase-multilingual-MiniLM-L12-v2).
# AI_EMBED_MODEL=
# Répertoire de cache persistant des poids ONNX (évite le re-téléchargement au cold start).
# AI_EMBED_CACHE_DIR=

# --- Ollama LLM (gemma4 — présentations / chat / sous-titres) ---------------
# Hôte Docker par défaut ; en dev local hors compose, pointer vers ton Ollama.
OLLAMA_URL=http://khoj-ollama:11434
OLLAMA_MODEL=gemma4:e4b

# --- Traduction IA de sous-titres ------------------------------------------
SUBTITLE_CHUNK_CUES=20          # cues SRT envoyées par appel LLM
SUBTITLE_CONCURRENCY=4          # appels de traduction concurrents max
SUBTITLE_MAX_CUES=3000          # au-delà → 413 (un long film ≈ 2500 cues)
SUBTITLE_MAX_BYTES=2000000      # au-delà (~2 Mo) → 413
SUBTITLE_PER_CHUNK_TIMEOUT=120  # timeout LLM par chunk (s)
SUBTITLE_TOTAL_TIMEOUT=600      # deadline requête entière (s) ; dépassé → 503
SUBTITLE_CACHE_RETENTION_DAYS=30  # purge des traductions plus vieilles que N jours (0 = jamais)

# --- Appairage TV (device-flow, /api/tv-auth/*) ----------------------------
# Clé Fernet optionnelle (urlsafe base64, 32 octets) pour chiffrer le payload au repos.
# RECOMMANDÉE en prod. Si vide, dérivée de AI_API_KEY (dérivation domain-separated
# depuis 2026-07-26 — AUDIT-P2-003/CR-S04 — donc différente de la clé Xtream
# dérivée du même AI_API_KEY par XTREAM_ENCRYPTION_KEY ci-dessous ; reste toutefois
# couplée à ce secret bearer : le faire tourner sans reconfigurer cette clé rend
# les payloads déjà chiffrés indéchiffrables). Si les deux sont vides → tv-auth
# renvoie 503.
# ⚠️ Note d'exploitation (déploiement du 2026-07-26, changement de dérivation) :
# les sessions d'appairage TV EN COURS au moment du déploiement deviennent
# indéchiffrables si TV_AUTH_ENCRYPTION_KEY n'était pas déjà configurée
# explicitement (le code renvoie un 503 propre, jamais un 500 — la TV relance
# simplement l'appairage). Fenêtre de casse = TV_AUTH_TTL_SECONDS (900 s par
# défaut). Si TV_AUTH_ENCRYPTION_KEY est déjà positionnée : aucun impact.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TV_AUTH_ENCRYPTION_KEY=
# TV_AUTH_TTL_SECONDS=900         # durée de vie d'une session d'appairage (s)

# --- Rate-limit ciblé sur POST /api/tv-auth/start (AUDIT-P2-004/CR-S05) -----
# Décision : PAS de limiteur global (l'app Android poll plusieurs endpoints
# authentifiés légitimement — un throttle global la pénaliserait). Le
# brute-force générique sur X-API-Key / Basic Auth (/admin, /dav, /metrics)
# reste délégué au WAF/ingress (Cloudflare) — même doctrine que /dav
# (CLAUDE.md §9 piège 18b). Seul /tv-auth/start est limité ici : c'est le
# SEUL endpoint non-authentifié qui écrit une ligne en base à chaque appel.
# Cap de requêtes par IP apparente (CF-Connecting-IP puis X-Forwarded-For
# puis l'IP TCP réelle — usurpable si ce process est joignable hors du
# tunnel, voir app/utils/rate_limit.py).
# TV_AUTH_START_RATE_LIMIT_MAX=5
# TV_AUTH_START_RATE_LIMIT_WINDOW_SECONDS=60
# Approximation en mémoire, par IP apparente, du nombre de sessions créées
# pas encore expirées (fenêtre = TV_AUTH_TTL_SECONDS, sur-comptage volontaire).
# TV_AUTH_PENDING_SESSIONS_CAP_PER_IP=20
# LA vraie protection contre le flood DB : plafond GLOBAL (pas par IP),
# calculé par un COUNT(*) réel en base — tient même si l'identification IP
# ci-dessus est totalement usurpée.
# TV_AUTH_PENDING_SESSIONS_CAP=500

# --- Compte Xtream (auto-provisionné au démarrage si les 3 champs sont remplis) ---
XTREAM_BASE_URL=
XTREAM_PORT=80
XTREAM_USERNAME=
XTREAM_PASSWORD=
# User-Agent envoyé à CHAQUE requête provider (player_api.php + validation de
# flux). Certains providers sont derrière Cloudflare et 403-bloquent le UA
# httpx par défaut — usurper un lecteur média réel évite ce blocage.
XTREAM_USER_AGENT=VLC/3.0.20 LibVLC/3.0.20

# --- Chiffrement au repos des mots de passe Xtream (CR-S03) -----------------
# Clé Fernet dédiée (urlsafe base64, 32 octets) RECOMMANDÉE en prod.
# Si vide, dérivée de AI_API_KEY (dérivation différente de TV_AUTH_ENCRYPTION_KEY,
# donc pas la même clé). Si les deux (celle-ci et AI_API_KEY) sont vides, les
# mots de passe Xtream restent en CLAIR (fail-open, ne bloque pas la sync) —
# renseigner l'une des deux clés pour activer le chiffrement.
# ⚠️ Si cette clé change après coup sans ré-exécuter la migration 016 sur les
# lignes déjà chiffrées, les mots de passe existants deviennent indéchiffrables.
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# XTREAM_ENCRYPTION_KEY=

# --- Tagging contenu adulte (+18 / XXX) -------------------------------------
# Films dont la catégorie Xtream matche un des mots-clés OU dont l'id figure
# dans ADULT_CATEGORY_IDS sont flaggés is_adult, forcés à ce content_rating
# (NFO <mpaa>) et préfixés côté API/bibliothèque générée. Films uniquement.
ADULT_CONTENT_RATING=XXX
ADULT_CATEGORY_KEYWORDS=adult,xxx,+18,18+,porn,porno,x-rated
# CSV de category_id Xtream à traiter comme adulte en plus des mots-clés.
# ADULT_CATEGORY_IDS=

# --- Répertoires données / logs --------------------------------------------
DATA_DIR=./data
LOG_DIR=./logs

# --- Synchronisation & enrichissement --------------------------------------
SYNC_INTERVAL_HOURS=6
ENRICHMENT_DAILY_LIMIT=50000
HEALTH_CHECK_BATCH_SIZE=1000

# --- Validation des flux ----------------------------------------------------
STREAM_VALIDATION_ENABLED=true
STREAM_VALIDATION_CONCURRENCY=20
STREAM_VALIDATION_TIMEOUT=15
STREAM_BROKEN_THRESHOLD=3
STREAM_VALIDATION_RECHECK_HOURS=24
STREAM_FILTER_BROKEN=true

# --- Sauvegardes DB (snapshots SQLite, cron quotidien) ---------------------
BACKUP_ENABLED=true
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=7
BACKUP_HOUR=4                   # heure (0-23) du cron de backup

# --- CORS -------------------------------------------------------------------
# Défaut `*` (ouvert) — RESTREINDRE en prod (liste séparée par des virgules).
CORS_ORIGINS=*

# --- Génération bibliothèque Plex/Jellyfin ---------------------------------
# Pas de défaut : à définir explicitement pour activer la génération auto au boot
# (en bare-metal / uvicorn). En Docker, voir PLEX_MEDIA_HOST_PATH ci-dessous.
# PLEX_LIBRARY_DIR=/path/to/plex/media

# --- WebDAV virtuel pour Plex (ticket DAV-1/DAV-2, docs/30-ops-plex-webdav.md) --
# Plex ignore totalement les .strm au scan (limite plateforme) — ce serveur
# WebDAV en lecture seule expose la même bibliothèque Xtream sous forme de
# vrais fichiers .mkv/.mp4 virtuels ; Plex y accède via un montage `rclone
# mount` sur le même hôte. INACTIF tant que DAV_ENABLED=false OU DAV_PASSWORD
# vide (fail-closed, /dav répond 503 dans les deux cas). Feature 100 %
# additive : les .strm Jellyfin ne sont jamais touchés.
DAV_ENABLED=false
DAV_USERNAME=plexdav
# REQUIS pour activer /dav (sinon 503). Généré via `rclone obscure` côté
# remote rclone — voir docs/30-ops-plex-webdav.md.
DAV_PASSWORD=
# ⚠️ Plex ffprobe CHAQUE fichier au scan et les comptes Xtream n'acceptent
# souvent que 1-3 connexions simultanées : COMMENCER BAS (25/5) et élargir
# par paliers (25 -> 250 -> 2500 -> ...) avec un scan Plex manuel entre
# chaque, jamais tout le catalogue d'un coup. 0 = illimité.
DAV_MOVIE_LIMIT=25
DAV_SERIES_LIMIT=5
# CSV de account_id Xtream à exposer ; vide = tous les comptes actifs.
# DAV_ACCOUNT_IDS=
DAV_INCLUDE_ADULT=false
# 1 seule version par titre (divise par 2 le nombre de fichiers à ffprober).
DAV_SINGLE_VERSION=true
# Exclut les versions sans file_size connu (une taille fausse casse rclone).
DAV_REQUIRE_KNOWN_SIZE=true
# Durée de vie du cache de l'arbre virtuel avant reconstruction automatique
# (l'arbre est aussi invalidé immédiatement après chaque génération Plex).
DAV_TREE_TTL_MINUTES=60
# Connexions upstream simultanées par compte Xtream — clampé par le
# max_connections réel du compte, jamais dépassé.
DAV_UPSTREAM_PER_ACCOUNT=1
# Délai d'attente d'un permis de connexion avant de répondre 503+Retry-After.
DAV_QUEUE_TIMEOUT_SECONDS=30
# Certains panels Xtream ignorent le header Range et renvoient toujours 200 —
# le relay re-découpe alors la réponse complète pour synthétiser un 206
# (sinon chaque chunk de lecture rclone re-télécharge le fichier entier).
DAV_RANGE_SHIM=true
# Timeouts httpx du relay (secondes) : connexion / lecture. Défaut = mêmes
# valeurs que DOWNLOAD_CONNECT_TIMEOUT/DOWNLOAD_READ_TIMEOUT ci-dessus (même
# classe de connexion provider Xtream), overridables indépendamment.
# DAV_CONNECT_TIMEOUT=30
# DAV_READ_TIMEOUT=120

# --- Téléchargement physique de médias (onglet admin « Télécharger ») -------
# Dossier DÉDIÉ où les vrais fichiers vidéo sont téléchargés (≠ PLEX_LIBRARY_DIR,
# qui ne contient que des .strm de référence). TANT QUE VIDE, la feature est
# INACTIVE (le worker de drain est un no-op) : à définir pour l'activer.
# En BARE-METAL / uvicorn : décommente et mets un chemin absolu ci-dessous.
# En DOCKER : NE touche PAS à ceci — DOWNLOAD_DIR est fixé à /app/downloads dans
# docker-compose.yml ; c'est DOWNLOAD_HOST_PATH (section Docker plus bas) qui
# choisit le dossier hôte réel.
# DOWNLOAD_DIR=/path/to/downloads
# Nombre de téléchargements simultanés drainés par le worker (master-only).
DOWNLOAD_CONCURRENCY=1
# Taille des chunks de streaming httpx (octets).
DOWNLOAD_CHUNK_BYTES=1048576
# Tentatives automatiques sur erreur transitoire avant d'échouer le job.
DOWNLOAD_MAX_RETRIES=3
# Préflight espace disque : refuse de démarrer un job si l'espace libre sous
# DOWNLOAD_DIR est inférieur à ce seuil (Mo). <=0 = désactivé.
DOWNLOAD_MIN_FREE_DISK_MB=2048
# Intervalle de polling de la file par le worker (secondes).
DOWNLOAD_POLL_INTERVAL=2
# Timeouts httpx du téléchargement (secondes) : connexion / lecture de chunk.
DOWNLOAD_CONNECT_TIMEOUT=30
DOWNLOAD_READ_TIMEOUT=120
# Redirections HTTP max suivies (Xtream 302 légitimement vers un CDN). Chaque
# saut est verrouillé anti-SSRF (résolution IP publique obligatoire). 0 =
# comportement strict d'origine (tout 3xx = échec permanent).
DOWNLOAD_MAX_REDIRECTS=5
# Plafond par source pour la fusion en mémoire de l'écran « Téléchargements »
# unifié (Xtream+Plex) ; au-delà, la fenêtre d'une source est tronquée (l'UI
# l'indique, jamais de troncature silencieuse).
UNIFIED_DOWNLOAD_MERGE_CAP=5000

# --- Trailers (popup Home pour les médias non-Plex) ------------------------
# Résout une clé YouTube en fichier mp4 ~720p mis en cache via yt-dlp, servi
# sous /api/media/trailer/*. ⚠️ DÉVIATION ASSUMÉE vs la convention habituelle
# « vide = désactivé » (DOWNLOAD_DIR ci-dessus) : celui-ci est ACTIF PAR
# DÉFAUT — décision d'orchestration (revue code) car l'opérateur auto-héberge
# et redéploie précisément pour cette fonctionnalité ; un opt-in aurait été
# un footgun « je redéploie, ça ne marche toujours pas ». Laissé commenté, il
# vaut DATA_DIR/trailers (même volume déjà monté que la base — aucun montage
# docker-compose supplémentaire nécessaire). Décommenter avec une chaîne VIDE
# pour désactiver explicitement la fonctionnalité (même convention que
# DOWNLOAD_DIR, juste avec la polarité de défaut inversée).
# TRAILER_CACHE_DIR=
# Taille max du cache de trailers (Mo) — purge LRU (par mtime) après chaque
# téléchargement + cron nocturne (qui purge aussi les répertoires de travail
# `.ytdlp-*` orphelins d'un crash/kill -9 mid-download).
TRAILER_CACHE_MAX_MB=2048
# Préflight espace disque : refuse de démarrer un téléchargement si l'espace
# libre sous TRAILER_CACHE_DIR est inférieur à ce seuil (Mo). <=0 = désactivé.
# Skip silencieux (le resolve reste "pending", réévalué à la prochaine
# requête) — jamais d'échec dur.
TRAILER_MIN_FREE_DISK_MB=512

# --- Serveurs Plex partagés (source de téléchargement « Télécharger Plex ») -
# Token de compte plex.tv (Settings > Account, "authentication token"). C'est
# un SECRET : jamais commité, jamais loggé. TANT QUE VIDE, la feature est
# INACTIVE (pas de découverte plex.tv, pas de sync catalogue) — le catalogue
# Plex est isolé de la table `media` existante (source Xtream inchangée).
# PLEX_ACCOUNT_TOKEN=
# Timeout de la sonde de connexion par serveur découvert (secondes).
PLEX_PROBE_TIMEOUT=5
# Intervalle du cron de sync catalogue Plex (heures). 0 = pas de cron
# périodique (sync manuel uniquement via l'admin).
PLEX_SYNC_INTERVAL_HOURS=0
# UUID stable envoyé en X-Plex-Client-Identifier à plex.tv. Optionnel : si
# vide, généré une seule fois et persisté dans DATA_DIR/plex_client_id (survit
# aux redémarrages). Ne renseigner que pour forcer une valeur explicite.
# PLEX_CLIENT_IDENTIFIER=

# ============================================================================
# Variables lues UNIQUEMENT par docker-compose.yml (pas par l'app Python)
# ============================================================================
# Port exposé du conteneur (et utilisé par le healthcheck).
APP_PORT=8000
# Fuseau horaire du conteneur.
TZ=UTC
# Chemin HÔTE monté sur /app/media (= PLEX_LIBRARY_DIR dans le conteneur).
PLEX_MEDIA_HOST_PATH=./media
# Chemin HÔTE monté sur /app/downloads (= DOWNLOAD_DIR dans le conteneur) pour
# la feature « Télécharger ». Crée le dossier avant `docker compose up`.
DOWNLOAD_HOST_PATH=./downloads

# --- Cloudflare Tunnel ------------------------------------------------------
# Jeton fourni par le tableau de bord Cloudflare (Zero Trust) pour exposer l'app
# sans ouvrir de ports.
# CLOUDFLARE_TUNNEL_TOKEN=ey...
